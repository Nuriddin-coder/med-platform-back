# Server configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/med_platform?schema=public"

# JWT configuration
JWT_ACCESS_SECRET="med_super_secret_access_key_change_in_production_2026"
JWT_REFRESH_SECRET="med_super_secret_refresh_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Application URLs
APP_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:5173"

# Seed Super Admin
SEED_SUPER_ADMIN_EMAIL="admin@med.uz"
SEED_SUPER_ADMIN_PASSWORD="Admin123!@#"

